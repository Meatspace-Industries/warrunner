{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "global": {
      "type": "object",
      "properties": {
        "imagePullSecrets": { "type": "array" }
      }
    },
    "firewall": {
      "type": "object",
      "properties": {
        "existingCaSecretName": { "type": "string" },
        "existingCaKeySecretName": { "type": "string" },
        "ca": {
          "type": "object",
          "properties": {
            "certPem": { "type": "string" },
            "keyPem": { "type": "string" }
          }
        }
      }
    },
    "ironProxy": {
      "type": "object",
      "properties": {
        "service": {
          "type": "object",
          "properties": {
            "proxyPort": { "type": "integer" },
            "managementPort": { "type": "integer" },
            "healthPort": { "type": "integer" },
            "pgPortRangeStart": { "type": "integer" },
            "pgPortRangeEnd": { "type": "integer" }
          }
        },
        "secretSource": { "type": "string" },
        "secretTtl": { "type": "string" }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "bootstrapSecretName": { "type": "string" }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "egressDiscovery": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string" },
            "clusterDomain": { "type": "string" },
            "tailnetFqdnAnnotation": { "type": "string" }
          }
        },
        "slackEtlEnabled": { "type": "boolean" },
        "slackSyncIntervalSeconds": { "type": "integer" },
        "slackSyncLookbackDays": { "type": "integer" },
        "slackSyncThreadLookbackDays": { "type": "integer" },
        "companyContextDocumentsIntervalSeconds": { "type": "integer" }
      }
    },
    "overlay": {
      "type": "object",
      "properties": {
        "mountPath": { "type": "string" },
        "systemPrompt": { "type": "string" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string" },
            "sourcePath": { "type": "string" }
          }
        }
      }
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "runtimeClassName": { "type": "string" },
        "reposPath": { "type": "string" },
        "resources": { "type": "object" }
      }
    },
    "repoCache": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "hostPath": { "type": "string" },
        "repositories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "syncIntervalSeconds": { "type": "integer" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string" }
          }
        },
        "githubToken": {
          "type": "object",
          "properties": {
            "existingSecretName": { "type": "string" },
            "secretKey": { "type": "string" },
            "token": { "type": "string" }
          }
        },
        "egressPorts": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "resources": { "type": "object" }
      }
    },
    "slackbot": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "discordbot": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string" }
          }
        },
        "applicationId": { "type": "string" },
        "botUserId": { "type": "string" },
        "guildId": { "type": "string" },
        "homeForumChannelId": { "type": "string" },
        "homeChannelIds": { "type": "string" },
        "intakeChannelIds": { "type": "string" },
        "allowedRoleIds": { "type": "string" },
        "historyLimit": { "type": "integer" },
        "requireHomeThread": { "type": "boolean" },
        "homeChannelMentionRequired": { "type": "boolean" },
        "typingEnabled": { "type": "boolean" },
        "typingRefreshMs": { "type": "integer" },
        "typingTimeoutMs": { "type": "integer" },
        "gatewayEnabled": { "type": "boolean" },
        "extraEnv": { "type": "object" },
        "resources": { "type": "object" }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "dataDir": { "type": "string" }
      }
    },
    "runnerAccess": {
      "type": "object",
      "properties": {
        "allowedCidrs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "dnsIpBlocks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ingressSourceNamespaces": {
          "type": "array",
          "items": { "type": "string" }
        },
        "apiIngressSourceNamespaces": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ingressControllerNamespaces": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
