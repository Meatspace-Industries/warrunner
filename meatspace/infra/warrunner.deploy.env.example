# Warrunner deploy env for ~/.config/warrunner/deploy.env.
# Do not set OPENAI_API_KEY. Codex uses ChatGPT login auth from ~/.codex/auth.json.

DISCORD_BOT_TOKEN=<discord-bot-token>
DISCORD_GUILD_ID=1435290709363130390
DISCORD_BOT_USER_ID=1508581976779657369
WARRUNNER_HOME_FORUM_CHANNEL_ID=
WARRUNNER_HOME_CHANNEL_IDS=1508220472569888950
WARRUNNER_ALLOWED_ROLE_IDS=1494022319855894579,1494022320438902886,1494022325862137876
WARRUNNER_ALLOWED_GITHUB_REPOS=Meatspace-Industries/dappios,Meatspace-Industries/dapp-backend,Meatspace-Industries/dappweb
WARRUNNER_GITHUB_REPO_ALIASES=dappios=Meatspace-Industries/dappios,dapp-ios=Meatspace-Industries/dappios,ios=Meatspace-Industries/dappios,dapp-backend=Meatspace-Industries/dapp-backend,backend=Meatspace-Industries/dapp-backend,dappweb=Meatspace-Industries/dappweb,dapp-web=Meatspace-Industries/dappweb,web=Meatspace-Industries/dappweb
# Repo-scoped turns are capped below the one-hour GitHub App token lifetime,
# leaving room for proxy/pod readiness waits and a safety buffer.
GITHUB_APP_REPO_EXECUTION_HARD_TIMEOUT_S=2400
GITHUB_APP_REPO_SESSION_REFRESH_MARGIN_S=2700

# Optional non-OpenAI harness/tool credentials. Leave unset unless needed.
# ANTHROPIC_API_KEY=
# AMP_API_KEY=

# Required for repo work. Do not set GITHUB_TOKEN; Warrunner mints scoped
# installation tokens from this GitHub App config per sandbox.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Set exactly one private-key source.
# GITHUB_APP_PRIVATE_KEY_FILE=/path/to/meatspace-warrunner.private-key.pem
# GITHUB_APP_PRIVATE_KEY_BASE64=
# GITHUB_APP_PRIVATE_KEY=
